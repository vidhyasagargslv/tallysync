# SQLite file for now. The SQL is plain and portable; swap lib/db.ts for Postgres later.
DATABASE_PATH=./data/tallysync.db
# Initial API key the agent must send in x-api-key. Can be regenerated on /settings (stored in DB).
TALLYSYNC_API_KEY=dev-tallysync-key-change-me
# Declarative Tally mapping (JSONC). Default ./config/tally-mapping.jsonc
TALLY_MAPPING_PATH=./config/tally-mapping.jsonc
